   - Inserção em ABB:
     Se valor < raiz->info: raiz->esq = inserir(raiz->esq, valor);
     Se valor > raiz->info: raiz->dir = inserir(raiz->dir, valor);
   - Busca em ABB:
     Se raiz == NULL return 0;
     Se valor == raiz->info return 1;
