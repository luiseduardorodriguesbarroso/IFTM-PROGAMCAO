{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug C",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/debug/programa",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "make build debug",
            "windows": {
                "program": "${workspaceFolder}/bin/debug/programa.exe",
                "miDebuggerPath": "c:/msys64/ucrt64/bin/gdb.exe"
            }
        }
    ]
}