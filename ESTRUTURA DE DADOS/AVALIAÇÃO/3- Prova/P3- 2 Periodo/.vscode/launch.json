{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug C",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/../bin/debug/programa.exe",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}/..",
            "environment": [],
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc arquivo de build ativo"
        }
    ]
}
