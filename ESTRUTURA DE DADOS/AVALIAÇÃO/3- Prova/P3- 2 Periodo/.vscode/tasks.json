{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make build debug",
            "type": "shell",
            "command": "make",
            "args": [
                "all"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "never",
                "echo": false,
                "showReuseMessage": false,
                "clear": true,
                "close": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc arquivo de build ativo",
            "command": "gcc",
            "args": [
                "-std=c2x",
                "-Wall",
                "-Wextra",
                "-I${fileDirname}/../include",
                "-I${workspaceFolder}/include",
                "-g",
                "${fileDirname}/*.c",
                "-o",
                "${fileDirname}/../bin/debug/programa.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compilação C com gcc no Windows."
        }
    ]
}
